const facts = [
  { label: 'විවෘත වේලාව', value: '06:00 — 18:00', note: 'දිනපතා · පිටත්වීමට පෙර තහවුරු කරන්න' },
  { label: 'නිර්දේශිත කාලය', value: 'පැය 1 — 3', note: 'ඇවිදීම, බෝට්ටු, තේ වේලාව' },
  { label: 'ස්ථානය', value: 'Nuwara Eliya', note: 'Central Province · Sri Lanka' },
  {
    label: 'ඇගයීම',
    value: '4.5 / 5',
    note: `Google සිතියම් සමාලෝචන ${rating.reviewCountLabel}`,
    source: true,
  },
];

const nearby = [
  { distance: 'ආසන්න', name: 'Gregory Lake', detail: 'වැව වටා උදෑසන මීදුම, නිස්කලංක ජලය සහ බෝට්ටු ගමන්.' },
  { distance: '≈ 2 km', name: 'Victoria Park', detail: 'මල් උද්‍යානයක්, කුරුලු නිරීක්ෂණය සහ නගරයේ තවත් සීතල විවේකයක්.' },
  { distance: 'දින භාගයක්', name: 'Tea Country', detail: 'තේ කර්මාන්තශාලා, බෑවුම් සහ මෘදු වලාකුළු අතරින් දසුන්.' },
  { distance: 'දින සංචාරයක්', name: 'Horton Plains', detail: 'World’s End සහ Baker’s Falls සඳහා උදෑසනින් පිටත් වන්න.' },
];

const guideLandmarks = [
  { name: 'Lake Gregory (Gregory Lake)', detail: 'The lake itself: lakeside walks, pedal boats, jet-ski and the misty water views the park is known for.' },
  { name: 'Victoria Park', detail: 'The town’s flower garden and birdwatching spot, a short tuk-tuk ride from the lake.' },
  { name: 'Hakgala Botanical Garden', detail: 'A hillside garden on the Badulla road, often paired with a Gregory Park morning.' },
  { name: 'Pedro Tea Estate & tea factories', detail: 'Working tea country with factory visits and tastings along the slopes above the town.' },
  { name: 'Lover’s Leap Waterfall', detail: 'A small waterfall just outside Nuwara Eliya, easy to add to a half-day loop.' },
  { name: 'Moon Plains', detail: 'A 4x4 viewpoint over the valley, usually visited early before the clouds arrive.' },
  { name: 'Horton Plains National Park', detail: 'A half-day trip for World’s End and Baker’s Falls; leave early from Nuwara Eliya.' },
