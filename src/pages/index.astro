const reviewThemes = [
  { label: 'මීදුම් උදෑසන', detail: 'වැවේ නිශ්චල ජලය සහ උදෑසන මීදුම බොහෝ දෙනා සඳහන් කරන ප්‍රධාන අත්දැකීමයි.' },
  { label: 'බෝට්ටු ගමන්', detail: 'pedal boat හෝ වැව මත බෝට්ටු ගමන පවුලේ අයට හොඳ ක්‍රියාකාරකමක් ලෙස සඳහන් වේ.' },
  { label: 'තණබිම් සහ ඇවිදීම', detail: 'හරිත තණබිම්, ඇවිදින මාර්ග සහ විවේක අවකාශ නිතර අගය කරයි.' },
  { label: 'පහසු ප්‍රවේශය', detail: 'නගරයට ආසන්න නිසා tuk-tuk එකකින් ඉක්මනින් පැමිණිය හැකි බව සඳහන් වේ.' },
  { label: 'සීතල දේශගුණය', detail: 'කඳුකර සිසිලස සහ උණු තේ කෝප්පයක් එකට ගැනෙන අත්දැකීමක් ලෙස සඳහන් වේ.' },
  { label: 'තදබද වේලාවන්', detail: 'නිවාඩු සහ සති අන්තවල රථවාහන තදබදය ගැන ද අදහස් තිබේ.' },
];

const sources = [
  {
    title: rating.reviewCountLabelZh,
    text: rating.reviewAttributionZh,
    linkLabel: '点击查看谷歌地图全部评价',
    href: rating.reviewsUrl,
  },
  {
    title: '地图与地点数据',
    text: `Google Maps listing for ${attraction.fullName}（Plus Code ${attraction.plusCode}，坐标 ${attraction.latitude}, ${attraction.longitude}）。`,
    linkLabel: '在谷歌地图查看地点',
    href: attraction.mapsShareUrl,
  },
  {
    title: '官方旅游信息',
    text: '斯里兰卡官方旅游主管机构发布的国家级旅游信息与最新通知。',
    linkLabel: attraction.govtTourismLabel,
    href: attraction.govtTourismUrl,
  },
  {
    title: '照片版权',
    text: '页面照片来自 Wikimedia Commons，版权归原作者，具体授权以各文件页说明为准。',
    linkLabel: 'Wikimedia Commons · Lake Gregory',
    href: attraction.imageCreditUrl,
  },
  {
    title: '开放时间与活动参考',
    text: '开放时间、建议停留时长与湖上活动等公开旅行资料（Trip.com、travelwithanjaly.com、GetYourGuide listing 等），仅作参考。',
    linkLabel: null,
    href: null,
  },
  {
    title: '免责声明',
    text: '本页为非官方访客指南，与 Gregory Park 管理方及 Google 无隶属关系。开放时间、门票、停车与活动可能随时调整，请以现场信息为准。',
    linkLabel: null,
    href: null,
  },
];

const mapSearchUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${attraction.plusCode}, ${attraction.highway}, ${attraction.city} ${attraction.postalCode} ${attraction.country}`)}`;
const canonicalHome = new URL('/', siteUrl).toString();
---

<Layout>
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Gregory Park මුල් පිටුව">
      <img src="/logo.svg" alt="Gregory Park Guide" width="200" height="58" />
    </a>
    <nav aria-label="ප්‍රධාන මෙනුව">
      {navItems.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="header-cta" href="#map">මාර්ගය බලන්න <span>↗</span></a>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-image" role="img" aria-label="Gregory Park — Gregory Lake හි ජලය සහ හරිත තණබිම්">
        <img
          src="/images/gregory-lake-park.webp"
          alt="Gregory Park — Gregory Lake පසෙකින් හරිත තණබිම් සහ කුඩා බෝට්ටුවක්, Nuwara Eliya, Sri Lanka"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero-wash"></div>
      <div class="hero-content">
        <p class="eyebrow">NUWARA ELIYA · 1,868 M උසක නගරය</p>
        <h1 id="hero-title">
          <span class="h1-entity">Gregory Park <i>(Nuwara Eliya)</i></span>
          <span class="h1-headline">මීදුම අතරින්<br /><em>වැවට</em> පැමිණෙන්න.</span>
        </h1>
        <p class="hero-lede">Gregory Park යනු Gregory Lake අසලින් සීතල කඳුකර වාතය, පැරණි උද්‍යාන රේඛා සහ මන්දගාමී දවසක් හමුවන ස්ථානයකි.</p>
        <div class="hero-actions">
          <a class="button button-copper" href="#plan">ගමන සැලසුම් කරන්න <span>↓</span></a>
          <a class="text-link light-link" href="#story">ස්ථානය දැනගන්න <span>→</span></a>
        </div>
      </div>
      <div class="hero-stamp" aria-hidden="true">
        <span>LAKE</span><strong>G</strong><span>PARK</span>
      </div>
      <div class="scroll-cue"><span>පහළට</span><i></i></div>
    </section>

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><span aria-current="page">Gregory Park (Nuwara Eliya)</span></li>
        <li><span>Nuwara Eliya</span></li>
        <li><span>Central Province</span></li>
        <li><span>Sri Lanka</span></li>
      </ol>
    </nav>

    <section class="intro section-pad" id="story">
      <div class="section-kicker"><span>01</span><span>ස්ථානයේ හැඟීම</span></div>
      <div class="intro-grid">
        <div>
          <p class="display-copy">පැරණි <span>කඳුකර</span><br />නිවාඩුවක වගේ.</p>
        </div>
        <div class="intro-copy">
          <p>මධ්‍යම ශ්‍රී ලංකාවේ තේ කඳු අතර Gregory Lake වටා දිගහැරෙන උද්‍යානය, නගරයේ වේගය මෘදු කරන කුඩා විවේකයකි. තණබිම් අසලින් සෙමින් ඇවිදින්න, ජලයේ කුඩා රැළි බලන්න, ඉන්පසු උණු තේ කෝප්පයක් සමඟ වලාකුළු ගමන් කරන හැටි බලා සිටින්න.</p>
          <a class="text-link dark-link" href="#plan">ඔබේ හොඳම පැය 3 <span>→</span></a>
        </div>
      </div>
      <div class="photo-strip">
        <figure class="photo-card photo-tall"><img src="/images/gregory-lake-mist.webp" alt="Gregory Park, Nuwara Eliya, Sri Lanka — Lake Gregory near Gregory Park වැව සහ මීදුම් සහිත කඳු" loading="lazy" /><figcaption>මීදුම · ජලය · නිහඬකම</figcaption></figure>
        <figure class="photo-card photo-wide"><img src="/images/gregory-lake-garden.webp" alt="Gregory Park, Nuwara Eliya, Sri Lanka — උද්‍යාන මාර්ගය සහ Gregory Lake අසල මල් සහිත උද්‍යානය" loading="lazy" /><figcaption>වැව දෙස බැලෙන උද්‍යාන මාර්ගය</figcaption></figure>
        <div class="quote-card"><span class="quote-mark">“</span><p>කඳුකරයේ හුස්ම ගන්නට වඩා හොඳ තැනක් නොමැති දවසක්.</p><small>— වැව අසල මන්දගාමී ගමනක්</small></div>
      </div>
    </section>

    <WeatherPanel />

    <section class="guide-section section-pad" id="guide" lang="en">
      <div class="section-kicker"><span>EN</span><span>Visitor guide · Gregory Park</span></div>
      <div class="guide-grid">
        <div>
          <article class="guide-block">
            <h2>About Gregory Park</h2>
            <p class="guide-lede">
              Welcome to <strong>Gregory Park</strong> — the central lakeside park of <strong>Nuwara Eliya</strong>, also searched
              for as{' '}
              <strong>Gregory Park Nuwara Eliya</strong> and <strong>Gregory Lake Park</strong>. Located in the heart of{' '}
              <strong>Nuwara Eliya</strong>, <strong>Central Province</strong>, <strong>Sri Lanka</strong>, this destination serves as a
              primary hub for travelers visiting the hill country: a garden landscape wrapped around the shore of Lake Gregory, roughly{' '}
              {attraction.elevationMetres} m above sea level.
            </p>
            <p>
              Published travel guides describe walking paths, lawns, benches, small snack stalls and boat rides on the water. Facilities,
              opening hours and activity prices are managed locally and can change, so treat everything on this page as a planning guide
              rather than an official tariff.
            </p>
          </article>

          <article class="guide-block" id="location">
            <h2>Location &amp; How to Visit Gregory Park in Nuwara Eliya</h2>
            <p>
              Gregory Park sits beside Lake Gregory on the {attraction.highway} in {attraction.city} (postal code {attraction.postalCode}).
              Its Plus Code is <strong>{attraction.plusCode}</strong>, which resolves to approximately{' '}
              <strong>{attraction.latitude}, {attraction.longitude}</strong> — inside {attraction.region}, {attraction.country}.
            </p>
            <p>
              From {attraction.city} town centre the trip is short: a tuk-tuk or taxi takes only a few minutes toward the lake. Renting a
              car or joining a day tour is common for guests staying outside town, and long-distance buses stop in {attraction.city}, from
              where a tuk-tuk covers the final leg. Early morning (06:00–09:00) and late afternoon (after 16:00) are usually the most
              comfortable windows, and highland rain can arrive at any time of day.
            </p>
            <p>
              For official updates and regional tourism information, visit{' '}
              <a href={attraction.govtTourismUrl} target="_blank" rel="noopener noreferrer">{attraction.govtTourismLabel}</a>.
            </p>
          </article>

          <article class="guide-block">
            <h2>Landmarks &amp; Attractions Around Gregory Park</h2>
            <p>
              When visiting <strong>{attraction.fullName}</strong>, visitors can easily explore surrounding historical landmarks and points
              of interest, including <strong>{attraction.nearbyLandmark1}</strong> and <strong>{attraction.nearbyLandmark2}</strong>.
            </p>
            <ul class="guide-nearby">
              {guideLandmarks.map((place) => (
                <li><strong>{place.name}</strong><span>{place.detail}</span></li>
              ))}
            </ul>
          </article>

          <article class="guide-block">
            <h2>History &amp; Significance of Gregory Park</h2>
            <p>
              Nuwara Eliya grew into a British hill station in the 19th century, and the lake at the centre of today’s park was created in
              1873, during the governorship of Sir William Gregory — the name the lake and the park still carry. What visitors now call
              Gregory Park is the public garden and lake shore that developed around that water body: a late-colonial leisure landscape of
              lawns, walks and viewpoints.
            </p>
            <p>
              Today it is one of the town’s main social spaces as well as a stop on most {attraction.city} itineraries, and it is the
              reference point for this guide. Where sources disagree on dates or details, this page follows the commonly published
              account and points readers to the official tourism portal above.
            </p>

            <div class="history-extra">
              <ol class="history-timeline">
                {
                  historyTimeline.map((h) => (
                    <li>
                      <span class="hy">{h.year}</span>
                      <div>
                        <h4>{h.title}</h4>
                        <p>{h.detail}</p>
                      </div>
                    </li>
                  ))
                }
              </ol>

              <div class="legend-box">
                <h3>Stories &amp; legends around the lake</h3>
                {
                  legendNotes.map((l) => (
                    <div class="legend-note">
                      <h4>{l.title}</h4>
                      <p>{l.detail}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          </article>
        </div>

        <aside class="guide-aside" aria-label="Gregory Park at a glance">
          <div class="guide-card">
            <h2 class="guide-card-title">At a glance</h2>
            <ul class="guide-facts">
              <li><span>Address</span><strong>{attraction.streetAddress}, {attraction.city} {attraction.postalCode}, {attraction.country}</strong></li>
              <li><span>Plus code</span><strong>{attraction.plusCode}</strong></li>
              <li><span>Coordinates</span><strong>{attraction.latitude}, {attraction.longitude}</strong></li>
              <li><span>Opening hours</span><strong>{attraction.openingHours} daily (verify on site)</strong></li>
              <li><span>Best time</span><strong>Early morning or late afternoon</strong></li>
              <li><span>Suggested stay</span><strong>1–3 hours</strong></li>
            </ul>
            <div class="guide-card-actions">
