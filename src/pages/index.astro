---
import Layout from '../layouts/Layout.astro';
import { attraction, faqs, faqsEn, rating, siteUrl } from '../data/attraction';
import { newSourceRows, historyTimeline, legendNotes } from '../data/visitor-guide';
import WeatherPanel from '../components/WeatherPanel.astro';
import TravelSections from '../components/TravelSections.astro';
import ServicesSections from '../components/ServicesSections.astro';

const navItems = [
  ['හැඟීම', '#story'],
  ['කාලගුණය', '#weather'],
  ['පැමිණීම', '#transport'],
  ['සැලසුම්', '#plan'],
  ['පහසුකම්', '#facilities'],
  ['සිතියම', '#map'],
  ['සමාලෝචන', '#reviews'],
